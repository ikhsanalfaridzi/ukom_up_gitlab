###########################
# Container Configuration #
###########################
	
CONTAINER_PROD_NAME=kev-basic
CONTAINER_NETWORK_NAME=kev-basic-pipeline

## Begin Platform
PLATFORM_USER=root
PLATFORM_IMAGE=kev/platform:v1-${CONTAINER_PROD_NAME}

PLATFORM_CONTAINER_NAME=kev_${CONTAINER_PROD_NAME}_platform
PLATFORM_PORT=
## End Platform

## Begin Webserver
CONTAINER_WEBSERVER_IMAGE=kev/webserver:v1-${CONTAINER_PROD_NAME}
CONTAINER_WEBSERVER_NAME=kev_${CONTAINER_PROD_NAME}_webserver
CONTAINER_WEBSERVER_PORT=
CONTAINER_WEBSERVER_PORT_HTTPS=
CONTAINER_WEBSERVER_SERVER_NAME=kevkw.id

CONTAINER_WEBSERVER_PLATFORM_SERVER=kev_${CONTAINER_PROD_NAME}_platform:9000
## End Webserver

## Begin Database
DATABASE_IMAGE=kev/database:v1-${CONTAINER_PROD_NAME}
DATABASE_CONTAINER_NAME=kev_${CONTAINER_PROD_NAME}_database
DATABASE_PORT=

DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
## End Database

## Begin Apps
APP_ENVIRONMENT=production
## End Apps

## Begin Storage
STORAGE_ROOT=.
STORAGE_APP=./storage/app
STORAGE_APP_TARGET=/var/webapps
## End Storage